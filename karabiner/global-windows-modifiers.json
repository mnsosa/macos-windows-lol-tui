{
  "title": "Windows-style macOS modifiers outside League",
  "rules": [
    {
      "description": "Outside League: Windows-style modifier positions",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_control",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "left_command" }],
          "conditions": [
            {
              "type": "frontmost_application_unless",
              "bundle_identifiers": [
                "^com\\.riotgames\\.LeagueofLegends\\.GameClient$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "left_command",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "left_control" }],
          "conditions": [
            {
              "type": "frontmost_application_unless",
              "bundle_identifiers": [
                "^com\\.riotgames\\.LeagueofLegends\\.GameClient$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "right_command",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "left_option" }],
          "conditions": [
            {
              "type": "frontmost_application_unless",
              "bundle_identifiers": [
                "^com\\.riotgames\\.LeagueofLegends\\.GameClient$"
              ]
            }
          ]
        }
      ]
    }
  ]
}
